{
  "permissions": {
    "allow": [
      "Read(//mnt/project-files/**)",
      "Edit(//mnt/project-files/**)",
      "Write(//mnt/project-files/**)",
      "Bash(python3:*)",
      "Bash(bash:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(python3 /mnt/project-files/valuation/nightly.py:*)",
      "Bash(python3 /mnt/project-files/valuation/runlock.py:*)",
      "Bash(python3 /mnt/project-files/valuation/review.py:*)",
      "Bash(python3 /mnt/project-files/valuation/live_quotes.py:*)",
      "Bash(python3 /mnt/project-files/valuation/build_report.py:*)",
      "Bash(curl * https://www.sec.gov/*)",
      "Bash(curl * \"https://www.sec.gov/*)",
      "Bash(curl * https://data.sec.gov/*)",
      "Bash(curl * \"https://data.sec.gov/*)",
      "Bash(curl * https://efts.sec.gov/*)",
      "Bash(curl * \"https://efts.sec.gov/*)",
      "WebFetch(domain:www.sec.gov)",
      "WebFetch(domain:data.sec.gov)",
      "WebFetch(domain:efts.sec.gov)",
      "Bash(cd /mnt/project-files)",
      "Bash(cd /mnt/project-files/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/artifact_watch.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/live_push_check.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__hearthbot__request_decision",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/card_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
