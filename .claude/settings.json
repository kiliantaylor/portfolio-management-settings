{
  "permissions": {
    "allow": [
      "Read(//mnt/project-files/**)",
      "Edit(//mnt/project-files/**)",
      "Write(//mnt/project-files/**)",
      "Bash(python3:*)",
      "Bash(bash:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(python3 /mnt/project-files/valuation/nightly.py:*)",
      "Bash(python3 /mnt/project-files/valuation/runlock.py:*)",
      "Bash(python3 /mnt/project-files/valuation/review.py:*)",
      "Bash(python3 /mnt/project-files/valuation/live_quotes.py:*)",
      "Bash(python3 /mnt/project-files/valuation/build_report.py:*)",
      "Bash(curl * https://www.sec.gov/*)",
      "Bash(curl * \"https://www.sec.gov/*)",
      "Bash(curl * https://data.sec.gov/*)",
      "Bash(curl * \"https://data.sec.gov/*)",
      "Bash(curl * https://efts.sec.gov/*)",
      "Bash(curl * \"https://efts.sec.gov/*)",
      "WebFetch(domain:www.sec.gov)",
      "WebFetch(domain:data.sec.gov)",
      "WebFetch(domain:efts.sec.gov)",
      "Bash(cd /mnt/project-files)",
      "Bash(cd /mnt/project-files/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/artifact_watch.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/live_push_check.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__hearthbot__request_decision",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/card_check.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__hearthbot__post_message|mcp__hearthbot__update_progress_checklist|mcp__hearthbot__post_widget|mcp__hearthbot__set_thread_resolved",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/open_cards_stop.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__hearthbot__post_message|mcp__hearthbot__edit_message|mcp__hearthbot__request_decision|mcp__hearthbot__post_widget|mcp__hearthbot__update_progress_checklist|mcp__hearthbot__rename_thread|mcp__Claude_Docs__batch|mcp__Claude_Docs__update",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/wording_check.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "WebFetch|Bash|mcp__.*navigate.*|mcp__claude-in-chrome__browser_batch|mcp__Google_Drive__create_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/update_speed_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
